// ===================== SOP FUNCTIONS =====================
function openSOP(type, role) {
  document.querySelectorAll(".dd").forEach(x => x.classList.remove("open"));
  document.querySelectorAll(".ni.has-dd").forEach(x => x.classList.remove("on"));

  if (type === "systems") {
    renderSystemsGrid();
    openModal("systems-modal");
    return;
  }

  const sop = ROLE_SOPS[role];
  if (!sop) return;

  document.getElementById("sop-modal-title").textContent = sop.icon + " " + role + " SOP";
  let html = "";
  sop.sections.forEach(sec => {
    html += `<div class="sop-section"><h3>${sec.title}</h3>`;
    sec.items.forEach((item, i) => {
      html += `<div class="sop-item"><span class="sop-num">${String(i+1).padStart(2,"0")}.</span><span class="sop-text">${item}</span></div>`;
    });
    html += `</div>`;
  });
  html += `<div class="sop-note">📌 This SOP is a living document. Content will be expanded by your administrator as processes are finalized. Check back regularly for updates.</div>`;
  document.getElementById("sop-modal-body").innerHTML = html;
  openModal("sop-modal");
}

function renderSystemsGrid() {
  const grid = document.getElementById("systems-grid");
  grid.innerHTML = SYSTEMS_SOPS.map(s => `
    <div class="sys-card" onclick="openSystemSOP('${s.id}')">
      <div class="sys-card-icon">${s.icon}</div>
      <div class="sys-card-title">${s.title}</div>
      <div class="sys-card-desc">${s.desc}</div>
    </div>
  `).join("");
}

function openSystemSOP(id) {
  const s = SYSTEMS_SOPS.find(x => x.id === id);
  if (!s) return;
  document.getElementById("sys-sop-title").textContent = s.icon + " " + s.title + " SOP";
  document.getElementById("sys-sop-body").innerHTML = `
    <div class="sop-placeholder">
      <div class="ph-icon">${s.icon}</div>
      <div style="font-size:14px;color:#888;margin-bottom:8px;font-weight:500">${s.title}</div>
      <div style="font-size:13px;color:#555;margin-bottom:16px">${s.desc}</div>
      <div style="font-size:12px;color:#444;border:1px dashed #333;border-radius:6px;padding:12px">
        This SOP is ready to be built out. Your administrator can add the full step-by-step process, checklists, and reference materials here.
      </div>
    </div>
    <div class="sop-note" style="margin-top:16px">📌 Systems &amp; Processes SOPs are built and maintained by the Project Director or Administrative Manager. Contact Bruce@legacyohiohomes.com to contribute content to this SOP.</div>
  `;
  closeModal("systems-modal");
  openModal("sys-sop-modal");
}

