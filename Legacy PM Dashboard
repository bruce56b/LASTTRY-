              `<select class="access-select" onchange="updateAccess(${u.id}, this.value)">
                <option value="readonly" ${u.accessLevel==="readonly"?"selected":""}>Read Only</option>
                <option value="standard" ${u.accessLevel==="standard"?"selected":""}>Standard</option>
                <option value="full" ${u.accessLevel==="full"?"selected":""}>Full Access</option>
              </select>`}
          </td>
          <td><span class="approved-badge">Active</span></td>
          <td>
            ${(!u.isSuperAdmin && u.id !== me.id) ? `<button class="revoke-btn" onclick="revokeUser(${u.id})">Revoke Access</button>` : `<span style="color:#444;font-size:11px">—</span>`}
          </td>
