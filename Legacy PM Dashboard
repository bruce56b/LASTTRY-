function openAdmin() {
  const session = getSession();
  if (!session) return;
  const users = getUsers();
  const me = users.find(u => u.id === session.id);
  if (!me || (me.accessLevel !== "full" && !me.isSuperAdmin)) return;

  renderAdminPending();
  renderAdminUsers();
  switchAdminTab("tab-pending");
  openModal("admin-modal");
}

function renderAdminPending() {
  const users = getUsers();
  const pending = users.filter(u => u.status === "pending");
  const badge = document.getElementById("pending-count-badge");
  badge.innerHTML = pending.length > 0 ? `<span style="background:#c0392b;color:#fff;border-radius:99px;padding:1px 7px;font-size:10px;margin-left:6px">${pending.length}</span>` : "";

