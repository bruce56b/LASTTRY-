const MONTHS = ["January","February","March","April","May","June","July","August","September","October","November","December"];

function getMRData() {
  try { return JSON.parse(localStorage.getItem("lh_monthly_reports") || "{}"); } catch(e) { return {}; }
}
function saveMRData(d) { localStorage.setItem("lh_monthly_reports", JSON.stringify(d)); }
function mrKey(year, month) { return String(year) + "_" + String(month); }

function openMonthlyReports() {
  document.querySelectorAll(".dd").forEach(x => x.classList.remove("open"));
  document.querySelectorAll(".ni.has-dd").forEach(x => x.classList.remove("on"));
  renderMRSidebar();
  const now = new Date();
  showMRForm(now.getFullYear(), now.getMonth());
  openModal("monthly-modal");
}

function renderMRSidebar() {
  const data = getMRData();
  const now = new Date();
  const currentYear = now.getFullYear();
  const years = new Set(Object.keys(data).map(k => k.split("_")[0]));
  years.add(String(currentYear));
  const sortedYears = Array.from(years).sort((a,b) => b - a);
  let html = `<div style="padding:0 0 8px 0">
    <div style="font-size:10px;color:#444;text-transform:uppercase;letter-spacing:0.06em;padding:8px 14px 6px">Years</div>`;
  sortedYears.forEach(yr => {
    html += `<div class="mr-year-block" id="mryr-${yr}">
      <div onclick="toggleMRYear('${yr}')" style="display:flex;align-items:center;justify-content:space-between;padding:8px 14px;cursor:pointer;color:#aaa;font-size:12px;font-weight:500;border-bottom:1px solid #1a1a1a" onmouseover="this.style.background='#1a1a1a'" onmouseout="this.style.background='transparent'">
        <span>${yr}</span><span id="mryr-chev-${yr}" style="font-size:10px;opacity:0.5">▾</span>
      </div>
      <div id="mryr-months-${yr}" style="display:block">`;
    MONTHS.forEach((m, mi) => {
      const key = mrKey(yr, mi);
      const saved = !!data[key];
      const isCurrent = parseInt(yr) === currentYear && mi === now.getMonth();
      html += `<div onclick="showMRForm('${yr}', ${mi})" id="mr-month-${yr}-${mi}"
        style="padding:7px 14px 7px 22px;font-size:12px;cursor:pointer;color:${saved ? '#2ecc71' : isCurrent ? '#5dade2' : '#555'};border-bottom:1px solid #141414;display:flex;align-items:center;gap:6px"
        onmouseover="this.style.background='#1a1a1a';this.style.color='#fff'" onmouseout="resetMRMonth('${yr}',${mi})">
        <span style="font-size:10px">${saved ? '●' : isCurrent ? '◉' : '○'}</span>${m}
      </div>`;
    });
    html += `</div></div>`;
  });
  html += `</div>
  <div style="padding:8px 14px;border-top:1px solid #1a1a1a;margin-top:4px">
    <button onclick="showNewYearPrompt()" style="width:100%;background:transparent;border:1px dashed #2a2a2a;border-radius:6px;padding:6px;font-size:11px;color:#444;cursor:pointer" onmouseover="this.style.borderColor='#555';this.style.color='#888'" onmouseout="this.style.borderColor='#2a2a2a';this.style.color='#444'">+ Add Year</button>
  </div>`;
  document.getElementById("mr-sidebar").innerHTML = html;
}

function resetMRMonth(yr, mi) {
  const data = getMRData();
  const now = new Date();
  const saved = !!data[mrKey(yr, mi)];
  const isCurrent = parseInt(yr) === now.getFullYear() && mi === now.getMonth();
  const el = document.getElementById(`mr-month-${yr}-${mi}`);
  if (el) { el.style.background = "transparent"; el.style.color = saved ? "#2ecc71" : isCurrent ? "#5dade2" : "#555"; }
}

function toggleMRYear(yr) {
  const el = document.getElementById(`mryr-months-${yr}`);
  const chev = document.getElementById(`mryr-chev-${yr}`);
  if (el) { const hidden = el.style.display === "none"; el.style.display = hidden ? "block" : "none"; if (chev) chev.textContent = hidden ? "▾" : "▸"; }
}

function showNewYearPrompt() {
  const yr = prompt("Enter a year to add (e.g. 2025):");
  if (yr && /^\d{4}$/.test(yr.trim())) { renderMRSidebar(); showMRForm(yr.trim(), 0); }
