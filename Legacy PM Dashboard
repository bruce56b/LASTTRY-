  return u.role === "Senior Virtual Administrative Assistant" || u.email === "idoko@legacyohiohomes.com";
}

// Hide restricted items based on logged-in user
function applyDataAccessUI() {
  const u = currentUser();
  const overhead = document.getElementById("dd-overhead");
  const teamspent = document.getElementById("dd-teamspent");
  if (!overhead || !teamspent) return;

  if (!u || !isBruce(u)) {
    overhead.style.opacity = "0.35";
    overhead.style.cursor = "not-allowed";
    overhead.onclick = (e) => { e.stopPropagation(); showAccessDenied("PT Overhead & Expenses is restricted to Bruce only."); };
  }
  if (!u || !isBruceOrSeniorVA(u)) {
    teamspent.style.opacity = "0.35";
    teamspent.style.cursor = "not-allowed";
    teamspent.onclick = (e) => { e.stopPropagation(); showAccessDenied("Project Team Spent is restricted to Bruce and the Senior Virtual Administrative Assistant."); };
  }
}

function showAccessDenied(msg) {
  document.querySelectorAll(".dd").forEach(x => x.classList.remove("open"));
  document.querySelectorAll(".ni.has-dd").forEach(x => x.classList.remove("on"));
  document.getElementById("access-denied-msg").textContent = msg;
  openModal("access-denied-modal");
}

