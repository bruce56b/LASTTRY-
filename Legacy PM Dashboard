        <div>
          <div style="font-size:14px;font-weight:500;color:#111">${liveName}</div>
          <div style="font-size:11px;color:#888">Project Manager · ${myProps.length} propert${myProps.length===1?'y':'ies'} · <span style="color:#E24B4A;font-weight:500">${upcoming14Count} task${upcoming14Count!==1?'s':''} due in 14 days</span></div>
        </div>
      </div>
      <div style="background:#fff;border:0.5px solid #e0e4ec;border-radius:10px;padding:12px 20px;text-align:center;flex-shrink:0;min-width:110px">
