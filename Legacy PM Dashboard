// ===================== MAIN DASHBOARD 5 BOARDS =====================
function renderMainDashboard() {
  const statCard = (label, val, sub, color) => `
    <div style="background:#fff;border:0.5px solid #e0e4ec;border-radius:8px;padding:12px 14px">
      <div style="font-size:10px;color:#999;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:6px">${label}</div>
      <div style="font-size:20px;font-weight:500;color:${color||'#111'}">${val}</div>
      <div style="font-size:11px;color:#aaa;margin-top:2px">${sub}</div>
    </div>`;

  // Collect sub phases across all properties
  const boards = {
    "SOW & Budgets":               [],
    "Permits & Drawings":          [],
    "Design Budgets & Design Status": [],
    "Takedowns / Vacancies":       [],
    "Pre Listing Phase":           [],
    "Remedy Requests / Upcoming Closings": [],
  };

  // Business day check — only include sub phases due within 5 business days
  function addBusinessDays(date, days) {
    let d = new Date(date); let added = 0;
    while (added < days) { d.setDate(d.getDate()+1); if (d.getDay()!==0&&d.getDay()!==6) added++; }
    return d;
  }
  const today = new Date(); today.setHours(0,0,0,0);
  const cutoff = addBusinessDays(today, 5);

  function isDueWithin5Biz(dueDateStr) {
    if (!dueDateStr) return false;
    const d = new Date(dueDateStr); d.setHours(0,0,0,0);
    return d >= today && d <= cutoff;
  }
  function isOverdue(dueDateStr) {
    if (!dueDateStr) return false;
    const d = new Date(dueDateStr); d.setHours(0,0,0,0);
    return d < today;
  }

  propCards.forEach(card => {
    if (card.phase === "Upcoming Takedowns" || card.phase === "Vacant / On Standby") {
      boards["Takedowns / Vacancies"].push({addr: card.addr, pm: card.pm, phase: card.phase, sub: "", due: card.end || "", overdue: false});
    }
    if (card.phase === "Pre List / Punchout Process") {
      boards["Pre Listing Phase"].push({addr: card.addr, pm: card.pm, phase: card.phase, sub: "Punchout / Pre-Listing", due: card.end || "", overdue: false});
    }
    if (card.phase === "In Contract" || card.phase === "RTR In Process" || card.phase === "RTR Completed (Pending Closing)") {
      boards["Remedy Requests / Upcoming Closings"].push({addr: card.addr, pm: card.pm, sub: card.phase, due: card.end || "", overdue: isOverdue(card.end)});
    }
    // Only sub phases due within 5 business days (or overdue)
    (card.subPhases || []).forEach(sp => {
      const boardName = SUB_PHASE_BOARD[sp.name];
      if (boardName && boards[boardName]) {
        if (isDueWithin5Biz(sp.due) || isOverdue(sp.due)) {
          boards[boardName].push({addr: card.addr, pm: card.pm, sub: sp.name, due: sp.due || "", overdue: isOverdue(sp.due)});
        }
      }
    });
  });

  // Sort: overdue first, then by soonest due date
  function sortBoard(items) {
    return [...items].sort((a, b) => {
      const aOver = a.overdue ? -1 : 0;
      const bOver = b.overdue ? -1 : 0;
      if (aOver !== bOver) return aOver - bOver;
      if (!a.due && !b.due) return 0;
      if (!a.due) return 1;
      if (!b.due) return -1;
      return new Date(a.due) - new Date(b.due);
    });
  }

  const boardCard = (title, color, dotColor, items) => `
    <div style="background:#fff;border:0.5px solid #e0e4ec;border-radius:10px;overflow:hidden;border-top:3px solid ${dotColor}">
      <div style="padding:10px 14px;border-bottom:0.5px solid #eef0f6;display:flex;align-items:center;justify-content:space-between">
        <div style="font-size:12px;font-weight:500;color:#111">${title}</div>
        <span style="font-size:11px;background:${color};color:${dotColor};padding:2px 8px;border-radius:99px;font-weight:500">${items.length}</span>
      </div>
      <div style="padding:10px 14px;min-height:140px">
        ${items.length === 0
          ? `<div style="text-align:center;color:#ccc;font-size:12px;padding:20px 0">No items due within 5 business days</div>`
          : items.slice(0,6).map(it => `
            <div style="padding:6px 0;border-bottom:0.5px solid #f4f5f7">
              <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:6px">
                <div style="flex:1;min-width:0">
                  <div style="font-size:12px;color:#111;font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${it.addr}</div>
                  <div style="font-size:10px;color:#888;margin-top:1px">${it.sub||it.phase||''}</div>
                </div>
              </div>
              <div style="display:flex;align-items:center;justify-content:space-between;margin-top:4px">
                ${it.pm ? `<div style="font-size:10px;padding:1px 6px;border-radius:99px;background:#f4f5f7;color:#555">${it.pm}</div>` : '<div></div>'}
                ${it.due ? `<div style="font-size:10px;font-weight:600;color:${it.overdue?'#c0392b':'#E24B4A'}">${it.overdue?'⚠ Overdue: ':'Due: '}${it.due}</div>` : ''}
              </div>
            </div>`).join('')}
        ${items.length > 6 ? `<div style="font-size:11px;color:#aaa;padding:6px 0">+${items.length-6} more</div>` : ''}
      </div>
    </div>`;

  return `
    <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:14px">
      ${statCard('Active Projects', countActive(), 'Framing → Pre-listing', '#111')}
      ${statCard('On the Market', countOnMarket(), 'Listed properties', '#5dade2')}
      ${statCard('Waiting Permits', countWaitingPermit(), 'Pending approval', '#f39c12')}
      ${statCard('Closed This Year', countClosedThisYear(), 'This calendar year', '#2ecc71')}
    </div>
    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:0">
      ${boardCard("SOW & Budgets",                "#E6F1FB","#185FA5", sortBoard(boards["SOW & Budgets"]))}
      ${boardCard("Permits & Drawings",           "#FBEAF0","#D4537E", sortBoard(boards["Permits & Drawings"]))}
      ${boardCard("Design Budgets & Status",      "#EEEDFE","#7F77DD", sortBoard(boards["Design Budgets & Design Status"]))}
      ${boardCard("Takedowns / Vacancies",        "#FCEBEB","#E24B4A", sortBoard(boards["Takedowns / Vacancies"]))}
      ${boardCard("Pre Listing Phase",            "#FAECE7","#D85A30", sortBoard(boards["Pre Listing Phase"]))}
      ${boardCard("Remedy Requests / Upcoming Closings","#EAF3DE","#3B6D11", sortBoard(boards["Remedy Requests / Upcoming Closings"]))}
    </div>`;
}

