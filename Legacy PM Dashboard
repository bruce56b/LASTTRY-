      if (idx >= 0) {
        propCards[idx].subPhases = propCards[idx].subPhases || [];
        propCards[idx].subPhases.push({name: sub, due: due});
      }
      closePropModal();
      openPropDetail(id);
    };
    document.getElementById("prop-modal").style.display = "block";
