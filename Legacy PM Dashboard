function openPropModal(mode, id) {
  const c = id ? propCards.find(x => x.id === id) : null;
  propEditingId = id || null;

  if (mode === 'companycam') {
    document.getElementById("prop-modal-title").textContent = "Add CompanyCam Link — " + (c ? c.addr : '');
    document.getElementById("prop-modal-body").innerHTML = `
      <div style="margin-bottom:12px">
        <label style="display:block;font-size:11px;color:#888;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:4px">CompanyCam Folder URL</label>
        <input id="pm-companycam" type="url" placeholder="https://app.companycam.com/projects/..." value="${c?c.companyCam||'':''}" style="width:100%;padding:7px 10px;border:0.5px solid #ccc;border-radius:6px;font-size:13px;color:#111;background:#fff;outline:none" />
      </div>
      <div style="font-size:11px;color:#aaa">Once your boss builds the auto-linking system, this will populate automatically when a CompanyCam folder is created for this property.</div>`;
    document.getElementById("prop-modal-save").onclick = () => {
      const url = document.getElementById("pm-companycam").value.trim();
      const idx = propCards.findIndex(x => x.id === id);
      if (idx >= 0) propCards[idx].companyCam = url;
      closePropModal();
      openPropDetail(id);
