function pmTabContent(name) {
  const liveName = resolvePMName(name);
  const pmColor = PROP_PM_COLORS[name] || '#ccc';

  const today = new Date(); today.setHours(0,0,0,0);

  function addBizDays(date, days) {
    let d = new Date(date); let added = 0;
    while (added < days) { d.setDate(d.getDate()+1); if(d.getDay()!==0&&d.getDay()!==6) added++; }
    return d;
  }
  const cutoff5 = addBizDays(today, 5);
  const cutoff14 = new Date(today); cutoff14.setDate(today.getDate()+14);

  function isOver(ds) { if(!ds) return false; const d=new Date(ds);d.setHours(0,0,0,0);return d<today; }
  function within5(ds) { if(!ds) return false; const d=new Date(ds);d.setHours(0,0,0,0);return d>=today&&d<=cutoff5; }
  function within14(ds) { if(!ds) return false; const d=new Date(ds);d.setHours(0,0,0,0);return d>=today&&d<=cutoff14; }

  // Build boards from THIS PM's properties only
  const myProps = propCards.filter(c => c.pm === name);

  const boards = {
    "SOW & Budgets":               [],
    "Permits & Drawings":          [],
    "Design Budgets & Design Status": [],
    "Takedowns / Vacancies":       [],
    "Pre Listing Phase":           [],
    "Remedy Requests / Upcoming Closings": [],
  };

  myProps.forEach(card => {
    if (card.phase==="Upcoming Takedowns"||card.phase==="Vacant / On Standby")
      boards["Takedowns / Vacancies"].push({addr:card.addr,pm:card.pm,phase:card.phase,sub:"",due:card.end||"",overdue:isOver(card.end)});
    if (card.phase==="Pre List / Punchout Process")
      boards["Pre Listing Phase"].push({addr:card.addr,pm:card.pm,phase:card.phase,sub:"Punchout / Pre-Listing",due:card.end||"",overdue:isOver(card.end)});
    if (card.phase==="In Contract"||card.phase==="RTR In Process"||card.phase==="RTR Completed (Pending Closing)")
      boards["Remedy Requests / Upcoming Closings"].push({addr:card.addr,pm:card.pm,sub:card.phase,due:card.end||"",overdue:isOver(card.end)});
    (card.subPhases||[]).forEach(sp => {
      const bn = SUB_PHASE_BOARD[sp.name];
      if (bn && boards[bn] && (within5(sp.due)||isOver(sp.due)))
        boards[bn].push({addr:card.addr,pm:card.pm,sub:sp.name,due:sp.due||"",overdue:isOver(sp.due)});
    });
  });

  // Sort each board: overdue → soonest due
  function sortB(items) {
    return [...items].sort((a,b)=>{
      if(a.overdue&&!b.overdue) return -1;
      if(!a.overdue&&b.overdue) return 1;
      if(!a.due&&!b.due) return 0;
      if(!a.due) return 1; if(!b.due) return -1;
      return new Date(a.due)-new Date(b.due);
    });
  }

  // Count upcoming tasks within 14 days across all sub phases
  let upcoming14Count = 0;
  myProps.forEach(card => {
    (card.subPhases||[]).forEach(sp => { if(within14(sp.due)) upcoming14Count++; });
    if(within14(card.end)) upcoming14Count++;
