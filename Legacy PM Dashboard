function switchTab(id) {
  document.querySelectorAll(".tab-content").forEach(el => {
    if (el.closest("#account-modal")) { el.classList.remove("active"); }
  });
  document.querySelectorAll("#account-modal .tab").forEach(t => t.classList.remove("active"));
  const target = document.getElementById(id);
  if (target) target.classList.add("active");
  const idx = ["tab-profile","tab-password"].indexOf(id);
  const tabs = document.querySelectorAll("#account-modal .tab");
  if (tabs[idx]) tabs[idx].classList.add("active");
}

function switchAdminTab(id) {
  document.querySelectorAll("#admin-modal .tab-content").forEach(el => el.classList.remove("active"));
  document.querySelectorAll("#admin-modal .tab").forEach(t => t.classList.remove("active"));
  const target = document.getElementById(id);
  if (target) target.classList.add("active");
  const idx = ["tab-pending","tab-users"].indexOf(id);
  const tabs = document.querySelectorAll("#admin-modal .tab");
  if (tabs[idx]) tabs[idx].classList.add("active");
}

