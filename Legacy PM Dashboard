// ===================== MODALS =====================
function openModal(id) { document.getElementById(id).classList.add("show"); }
function closeModal(id) { document.getElementById(id).classList.remove("show"); }
function switchModal(from, to) { closeModal(from); openModal(to); }

// ===================== SIGN IN =====================
function doSignIn() {
  const email = document.getElementById("signin-email").value.trim().toLowerCase();
  const pass = document.getElementById("signin-pass").value;
  const err = document.getElementById("signin-error");
  const ok = document.getElementById("signin-success");
  err.style.display = "none"; ok.style.display = "none";

  if (!email || !pass) { showErr(err, "Please fill in all fields."); return; }
  if (!email.endsWith("@legacyohiohomes.com")) { showErr(err, "Only @legacyohiohomes.com email addresses are allowed."); return; }

  const users = getUsers();
  const user = users.find(u => u.email === email && u.password === pass);
  if (!user) { showErr(err, "Invalid email or password."); return; }
  if (user.status === "pending") { showErr(err, "Your account is pending admin approval. You will be notified once approved."); return; }
  if (user.status === "denied") { showErr(err, "Your account registration was not approved. Contact Bruce@legacyohiohomes.com."); return; }

  saveSession({ id: user.id });
  closeModal("signin-modal");
  init();
}

// ===================== REGISTER =====================
function doRegister() {
  const first = document.getElementById("reg-first").value.trim();
  const last = document.getElementById("reg-last").value.trim();
  const email = document.getElementById("reg-email").value.trim().toLowerCase();
  const phone = document.getElementById("reg-phone").value.trim();
  const role = document.getElementById("reg-role").value;
  const pass = document.getElementById("reg-pass").value;
  const pass2 = document.getElementById("reg-pass2").value;
  const err = document.getElementById("reg-error");
  const ok = document.getElementById("reg-success");
  err.style.display = "none"; ok.style.display = "none";

  if (!first || !last || !email || !phone || !role || !pass || !pass2) { showErr(err, "Please fill in all fields."); return; }
  if (!email.endsWith("@legacyohiohomes.com")) { showErr(err, "Registration is only open to @legacyohiohomes.com email addresses."); return; }
  if (pass.length < 8) { showErr(err, "Password must be at least 8 characters."); return; }
  if (pass !== pass2) { showErr(err, "Passwords do not match."); return; }

  const users = getUsers();
  if (users.find(u => u.email === email)) { showErr(err, "An account with this email already exists."); return; }

  const newUser = {
    id: Date.now(),
    firstName: first,
    lastName: last,
    email: email,
    phone: phone,
    role: role,
    password: pass,
    status: "pending",
    accessLevel: "standard",
    isSuperAdmin: false,
    createdAt: new Date().toISOString().split("T")[0]
  };
  users.push(newUser);
  saveUsers(users);

  ok.textContent = "Registration submitted! Bruce@legacyohiohomes.com will review and approve your account.";
  ok.style.display = "block";
  document.getElementById("reg-first").value = "";
  document.getElementById("reg-last").value = "";
  document.getElementById("reg-email").value = "";
  document.getElementById("reg-phone").value = "";
  document.getElementById("reg-role").value = "";
  document.getElementById("reg-pass").value = "";
  document.getElementById("reg-pass2").value = "";
}

// ===================== SIGN OUT =====================
function doSignOut() { clearSession(); init(); }

// ===================== ACCOUNT =====================
function openAccount() {
  const session = getSession();
  if (!session) { openModal("signin-modal"); return; }
  const users = getUsers();
  const user = users.find(u => u.id === session.id);
  if (!user) return;

  document.getElementById("acct-sub").textContent = user.email;
  document.getElementById("acct-email-display").textContent = user.email;
  document.getElementById("acct-role-display").textContent = user.role;
  const alEl = document.getElementById("acct-access-display");
  const alMap = { full: ["Full Access","al-full"], standard: ["Standard Access","al-standard"], readonly: ["Read Only","al-readonly"] };
  const [label, cls] = alMap[user.accessLevel] || ["Standard","al-standard"];
  alEl.innerHTML = `<span class="access-level-badge ${cls}">${label}</span>`;
  document.getElementById("acct-first").value = user.firstName;
  document.getElementById("acct-last").value = user.lastName;
  document.getElementById("acct-phone").value = user.phone;

  switchTab("tab-profile");
  openModal("account-modal");
}

function saveProfile() {
  const session = getSession();
  const users = getUsers();
  const idx = users.findIndex(u => u.id === session.id);
  const err = document.getElementById("profile-error");
  const ok = document.getElementById("profile-success");
  err.style.display="none"; ok.style.display="none";

  const first = document.getElementById("acct-first").value.trim();
  const last = document.getElementById("acct-last").value.trim();
  const phone = document.getElementById("acct-phone").value.trim();
  if (!first || !last) { showErr(err, "First and last name are required."); return; }

  users[idx].firstName = first;
  users[idx].lastName = last;
  users[idx].phone = phone;
  saveUsers(users);
  saveSession({ id: users[idx].id });
  ok.textContent = "Profile updated successfully.";
  ok.style.display = "block";
  init();
}

function changePassword() {
  const session = getSession();
  const users = getUsers();
  const idx = users.findIndex(u => u.id === session.id);
  const err = document.getElementById("pw-error");
  const ok = document.getElementById("pw-success");
  err.style.display="none"; ok.style.display="none";

  const cur = document.getElementById("pw-current").value;
  const nw = document.getElementById("pw-new").value;
  const conf = document.getElementById("pw-confirm").value;

  if (!cur || !nw || !conf) { showErr(err, "Please fill in all fields."); return; }
  if (users[idx].password !== cur) { showErr(err, "Current password is incorrect."); return; }
  if (nw.length < 8) { showErr(err, "New password must be at least 8 characters."); return; }
  if (nw !== conf) { showErr(err, "New passwords do not match."); return; }

  users[idx].password = nw;
  saveUsers(users);
  ok.textContent = "Password updated successfully.";
