function renderPMHome(user) {
  // Match to a PM key by email
  const pmKey = Object.keys(PM_DATA).find(k => PM_DATA[k].email === user.email) || null;
  const pmName = pmKey || user.firstName;

  const today = new Date(); today.setHours(0,0,0,0);
  const cutoff14 = new Date(today); cutoff14.setDate(today.getDate()+14);
  function within14(ds) { if(!ds) return false; const d=new Date(ds);d.setHours(0,0,0,0);return d>=today&&d<=cutoff14; }
  function isOver(ds) { if(!ds) return false; const d=new Date(ds);d.setHours(0,0,0,0);return d<today; }

  const myProps = propCards.filter(c => c.pm === pmName);
  let allTasks = [];
  let upcoming14Count = 0;
  myProps.forEach(card => {
    (card.subPhases||[]).forEach(sp => {
      if(sp.due) { allTasks.push({addr:card.addr,task:sp.name,due:sp.due,overdue:isOver(sp.due)}); if(within14(sp.due)) upcoming14Count++; }
    });
    if(card.end) { allTasks.push({addr:card.addr,task:'Completion',due:card.end,overdue:isOver(card.end)}); if(within14(card.end)) upcoming14Count++; }
  });
  allTasks.sort((a,b)=>new Date(a.due)-new Date(b.due));
  const top10 = allTasks.slice(0,10);

  const taskRows = top10.length === 0
    ? `<div style="text-align:center;color:#555;font-size:12px;padding:16px 0">No upcoming tasks — will connect to task manager</div>`
    : top10.map(t=>`
      <div style="display:flex;align-items:center;justify-content:space-between;padding:7px 0;border-bottom:0.5px solid #1e1e1e">
        <div><div style="font-size:12px;color:#fff;font-weight:500">${t.task}</div><div style="font-size:11px;color:#666">${t.addr}</div></div>
        <div style="font-size:11px;font-weight:600;color:${t.overdue?'#e74c3c':'#E24B4A'};text-align:right">${t.overdue?'⚠ Overdue':'Due'}<br><span style="font-weight:400;color:#555">${t.due}</span></div>
      </div>`).join('');

  return `<div style="padding:20px 24px;max-width:100%">
    ${welcomeHeader(user)}
    <div style="background:#111;border:1px solid #2a2a2a;border-radius:10px;overflow:hidden;margin-bottom:14px">
      <div style="padding:10px 16px;border-bottom:1px solid #2a2a2a;display:flex;align-items:center;justify-content:space-between">
        <div style="font-size:12px;font-weight:500;color:#fff">📋 Upcoming Due Tasks</div>
        <div style="display:flex;align-items:center;gap:8px">
          <span style="font-size:10px;background:#1a2744;color:#5dade2;padding:2px 8px;border-radius:99px">${upcoming14Count} due in 14 days</span>
          <span style="font-size:10px;color:#444;background:#1a1a1a;padding:2px 7px;border-radius:4px">Task portal + Project Dashboard · Top 10</span>
        </div>
      </div>
      <div style="padding:8px 16px">${taskRows}</div>
    </div>
    ${sharedWidgets()}
  </div>`;
}


