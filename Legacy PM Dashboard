function approveUser(id) {
  const users = getUsers();
  const idx = users.findIndex(u => u.id === id);
  if (idx < 0) return;
  users[idx].status = "approved";
  saveUsers(users);
  renderAdminPending();
  renderAdminUsers();
}

function denyUser(id) {
  const users = getUsers();
  const idx = users.findIndex(u => u.id === id);
  if (idx < 0) return;
  users[idx].status = "denied";
  saveUsers(users);
  renderAdminPending();
}

function updateAccess(id, level) {
  const users = getUsers();
  const idx = users.findIndex(u => u.id === id);
  if (idx < 0) return;
  users[idx].accessLevel = level;
  saveUsers(users);
  renderAdminUsers();
  init();
}

function revokeUser(id) {
  if (!confirm("Revoke this user's access? They will no longer be able to sign in.")) return;
  const users = getUsers();
  const idx = users.findIndex(u => u.id === id);
  if (idx < 0) return;
  users[idx].status = "revoked";
  saveUsers(users);
  renderAdminUsers();
}

