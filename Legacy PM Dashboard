function doSearch() {
  const q = document.getElementById("site-search").value.trim();
  document.getElementById("search-modal-input").value = q;
  liveSearch(q);
  openModal("search-modal");
  setTimeout(() => document.getElementById("search-modal-input").focus(), 50);
}

function liveSearch(q) {
  const el = document.getElementById("search-results");
  const term = q.trim().toLowerCase();
  if (!term) {
    el.innerHTML = `<div style="padding:24px;text-align:center;color:#555;font-size:13px">Start typing to search the dashboard...</div>`;
    return;
  }
  const results = SEARCH_INDEX.filter(item =>
    item.title.toLowerCase().includes(term) || item.desc.toLowerCase().includes(term)
  );
  if (results.length === 0) {
    el.innerHTML = `<div style="padding:24px;text-align:center;color:#555;font-size:13px">No results found for "<span style="color:#888">${q}</span>"</div>`;
    return;
  }
  el.innerHTML = results.map((r,i) => `
    <div onclick="searchGo(${i})" style="padding:11px 20px;border-bottom:1px solid #1e1e1e;cursor:pointer;display:flex;align-items:center;gap:12px" onmouseover="this.style.background='#1a1a1a'" onmouseout="this.style.background='transparent'">
      <div style="flex:1">
        <div style="font-size:13px;color:#fff;margin-bottom:2px">${r.title}</div>
        <div style="font-size:11px;color:#555">${r.desc}</div>
      </div>
      <div style="font-size:11px;color:#333">↗</div>
    </div>`).join("");
  // store filtered results for click access
  window._searchResults = results;
}

function searchGo(i) {
  const results = window._searchResults || [];
  if (results[i]) {
    closeModal("search-modal");
    document.getElementById("site-search").value = "";
    results[i].action();
  }
}

