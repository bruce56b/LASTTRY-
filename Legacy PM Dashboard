<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Legacy Homes PM Dashboard</title>
<style>
*{box-sizing:border-box;margin:0;padding:0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif}
body{background:#1a1a1a;color:#fff;min-height:100vh}

/* HEADER */
.util-bar{background:#111;border-bottom:1px solid #2a2a2a;padding:6px 20px;display:flex;align-items:center;justify-content:space-between;min-height:36px}
.site-title{font-size:12px;font-weight:500;color:#fff;white-space:nowrap;margin-right:12px}
.util-right{display:flex;align-items:center;gap:6px;flex-shrink:0}
.udiv{width:1px;height:14px;background:#444;flex-shrink:0}
.ubtn{display:flex;align-items:center;gap:4px;padding:5px 10px;font-size:11px;border-radius:6px;cursor:pointer;border:1px solid #444;background:transparent;color:#fff;white-space:nowrap;flex-shrink:0}
.ubtn:hover{background:#2a2a2a}
.ubtn.primary{background:#fff;color:#111;border-color:#fff;font-weight:500}
.ubtn.primary:hover{background:#e8e8e8}
.brand-search{display:flex;align-items:center;background:#1a1a1a;border:1px solid #2a2a2a;border-radius:6px;overflow:hidden;width:220px;flex-shrink:0;margin-left:32px}
.brand-search input{flex:1;background:transparent;border:none;outline:none;padding:5px 10px;font-size:12px;color:#fff;min-width:0}
.brand-search input::placeholder{color:#555}
.brand-search:focus-within{border-color:#555}
.brand-search-btn{padding:5px 8px;background:transparent;border:none;color:#555;cursor:pointer;font-size:13px;flex-shrink:0}
.brand-search-btn:hover{color:#fff}

.brand-bar{background:#111;padding:10px 20px;display:flex;align-items:center;border-bottom:1px solid #2a2a2a}
.brand-bar img{height:46px;width:auto;display:block}
.brand-divider{width:1px;height:50px;background:#333;margin:0 20px}
.brand-main{font-size:17px;font-weight:500;color:#fff}
.brand-sub{font-size:12px;color:#888;margin-top:2px}

.nav{background:#1a1a1a;display:flex;width:100%;border-bottom:1px solid #2a2a2a;overflow:visible}
.ni{flex:1;min-width:0;padding:0 6px;font-size:10.5px;color:#aaa;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:3px;height:42px;white-space:nowrap;border-right:1px solid #2a2a2a;transition:background 0.12s;position:relative;overflow:visible}
.ni:last-child{border-right:none}
.ni:hover,.ni.on{background:#2a2a2a;color:#fff}
.ni svg{width:13px;height:13px;flex-shrink:0}
.chev{font-size:10px;opacity:0.5}

.dd{display:none;position:absolute;top:42px;left:0;background:#1e1e1e;border:1px solid #333;border-radius:0 0 8px 8px;min-width:210px;z-index:100}
.dd.open{display:block}
.ddl{font-size:10px;padding:8px 14px 4px;color:#666;text-transform:uppercase;letter-spacing:.06em;border-bottom:1px solid #2a2a2a}
.ddi{padding:9px 14px;font-size:12px;color:#ccc;cursor:pointer;border-bottom:1px solid #2a2a2a;display:flex;align-items:center;gap:8px}
.ddi:last-child{border-bottom:none}
.ddi:hover{background:#2a2a2a;color:#fff}

/* MODALS */
.overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,0.75);z-index:1000;align-items:center;justify-content:center}
.overlay.show{display:flex}
.modal{background:#1e1e1e;border:1px solid #333;border-radius:12px;width:100%;max-width:480px;padding:32px;position:relative;max-height:90vh;overflow-y:auto}
.modal h2{font-size:18px;font-weight:500;color:#fff;margin-bottom:6px}
.modal .sub{font-size:13px;color:#888;margin-bottom:24px}
.modal-close{position:absolute;top:16px;right:16px;background:none;border:none;color:#666;font-size:20px;cursor:pointer;line-height:1}
.modal-close:hover{color:#fff}

.form-row{margin-bottom:16px}
.form-row label{display:block;font-size:12px;color:#888;margin-bottom:6px;text-transform:uppercase;letter-spacing:0.04em}
.form-row input,.form-row select{width:100%;padding:10px 12px;background:#111;border:1px solid #333;border-radius:6px;color:#fff;font-size:14px;outline:none}
.form-row input:focus,.form-row select:focus{border-color:#555}
.form-row input::placeholder{color:#555}
.form-row select option{background:#111}
.form-two{display:grid;grid-template-columns:1fr 1fr;gap:12px}

.btn-full{width:100%;padding:11px;background:#fff;color:#111;border:none;border-radius:6px;font-size:14px;font-weight:500;cursor:pointer;margin-top:8px}
.btn-full:hover{background:#e8e8e8}
.btn-full.outline{background:transparent;color:#fff;border:1px solid #444;margin-top:0}
.btn-full.outline:hover{background:#2a2a2a}
.btn-full.danger{background:#c0392b;color:#fff}
.btn-full.danger:hover{background:#a93226}

.form-switch{text-align:center;margin-top:16px;font-size:13px;color:#888}
.form-switch a{color:#aaa;text-decoration:underline;cursor:pointer}
.form-switch a:hover{color:#fff}

.divider-line{border:none;border-top:1px solid #2a2a2a;margin:20px 0}

.error-msg{background:#2d1515;border:1px solid #c0392b;border-radius:6px;padding:10px 12px;font-size:13px;color:#e74c3c;margin-bottom:16px;display:none}
.success-msg{background:#0f2d1a;border:1px solid #27ae60;border-radius:6px;padding:10px 12px;font-size:13px;color:#2ecc71;margin-bottom:16px;display:none}

.pending-badge{display:inline-block;background:#2d2200;border:1px solid #f39c12;color:#f39c12;font-size:11px;padding:2px 8px;border-radius:99px;margin-left:8px}
.approved-badge{display:inline-block;background:#0f2d1a;border:1px solid #27ae60;color:#2ecc71;font-size:11px;padding:2px 8px;border-radius:99px;margin-left:8px}
.denied-badge{display:inline-block;background:#2d1515;border:1px solid #c0392b;color:#e74c3c;font-size:11px;padding:2px 8px;border-radius:99px;margin-left:8px}

/* ADMIN PANEL */
.admin-panel{padding:24px}
.panel-title{font-size:16px;font-weight:500;color:#fff;margin-bottom:16px;display:flex;align-items:center;gap:10px}
.user-table{width:100%;border-collapse:collapse;font-size:13px}
.user-table th{text-align:left;padding:8px 12px;color:#666;font-weight:400;font-size:11px;text-transform:uppercase;letter-spacing:0.04em;border-bottom:1px solid #2a2a2a}
.user-table td{padding:10px 12px;border-bottom:1px solid #1a1a1a;color:#ccc;vertical-align:middle}
.user-table tr:hover td{background:#222}
.access-select{background:#111;border:1px solid #333;border-radius:4px;color:#fff;padding:4px 8px;font-size:12px;cursor:pointer}
.action-btn{padding:4px 10px;font-size:11px;border-radius:4px;cursor:pointer;border:none;margin-right:4px}
.approve-btn{background:#0f2d1a;color:#2ecc71;border:1px solid #27ae60}
.approve-btn:hover{background:#1a4a2a}
.deny-btn{background:#2d1515;color:#e74c3c;border:1px solid #c0392b}
.deny-btn:hover{background:#4a2020}
.revoke-btn{background:#2d2200;color:#f39c12;border:1px solid #f39c12;font-size:11px;padding:4px 10px;border-radius:4px;cursor:pointer}
.revoke-btn:hover{background:#4a3800}

/* DASHBOARD BODY */
.dash-body{min-height:200px;}
.empty-state{text-align:center;color:#444;padding:60px 24px;}
.empty-state .icon{font-size:40px;margin-bottom:12px}
.empty-state p{font-size:14px;color:#555}

/* ACCOUNT MODAL TABS */
.tab-row{display:flex;gap:0;margin-bottom:24px;border-bottom:1px solid #2a2a2a}
.tab{padding:8px 16px;font-size:13px;color:#666;cursor:pointer;border-bottom:2px solid transparent;margin-bottom:-1px}
.tab.active{color:#fff;border-bottom-color:#fff}
.tab:hover{color:#ccc}
.tab-content{display:none}
.tab-content.active{display:block}

.section-label{font-size:11px;color:#666;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:12px;margin-top:20px}
.info-row{display:flex;justify-content:space-between;align-items:center;padding:10px 0;border-bottom:1px solid #222}
.info-row .label{font-size:13px;color:#888}
.info-row .val{font-size:13px;color:#ccc}
.role-pill{background:#1a2744;border:1px solid #2e4070;color:#8da4c8;font-size:11px;padding:3px 10px;border-radius:99px}

.access-level-badge{font-size:11px;padding:3px 10px;border-radius:99px;font-weight:500}
.al-full{background:#0f2d1a;color:#2ecc71;border:1px solid #27ae60}
.al-standard{background:#1a2744;color:#8da4c8;border:1px solid #2e4070}
.al-readonly{background:#2d2200;color:#f39c12;border:1px solid #f39c12}

/* PM DASHBOARD */
.pm-stats-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-bottom:24px}
.pm-stat-card{background:#111;border:1px solid #2a2a2a;border-radius:10px;padding:18px 16px}
.pm-stat-label{font-size:11px;color:#666;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:10px;line-height:1.4}
.pm-stat-value{font-size:28px;font-weight:500;color:#fff;margin-bottom:4px}
.pm-stat-sub{font-size:11px;color:#555}
.pm-stat-card.green .pm-stat-value{color:#2ecc71}
.pm-stat-card.amber .pm-stat-value{color:#f39c12}
.pm-stat-card.blue .pm-stat-value{color:#5dade2}
.pm-stat-card.coral .pm-stat-value{color:#e74c3c}
.pm-stat-card.purple .pm-stat-value{color:#a29bfe}
.pm-section-title{font-size:12px;color:#666;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:12px;padding-bottom:6px;border-bottom:1px solid #2a2a2a}
.pm-note{background:#1a1a1a;border:1px dashed #333;border-radius:8px;padding:14px 16px;font-size:12px;color:#555;text-align:center;margin-top:8px}
.pm-avatar{width:52px;height:52px;border-radius:50%;background:#1a2744;border:2px solid #2e4070;display:flex;align-items:center;justify-content:center;font-size:20px;margin-bottom:14px}
.sop-section{margin-bottom:24px}
.sop-section h3{font-size:13px;font-weight:500;color:#fff;margin-bottom:10px;padding-bottom:6px;border-bottom:1px solid #2a2a2a;text-transform:uppercase;letter-spacing:0.05em}
.sop-item{display:flex;gap:10px;padding:7px 0;border-bottom:1px solid #1e1e1e;align-items:flex-start}
.sop-item:last-child{border-bottom:none}
.sop-num{font-size:12px;color:#555;min-width:22px;padding-top:1px}
.sop-text{font-size:13px;color:#ccc;line-height:1.5}
.sop-note{background:#1a1a1a;border-left:3px solid #444;padding:10px 14px;border-radius:0 6px 6px 0;font-size:12px;color:#888;margin-top:8px;line-height:1.5}
.sop-placeholder{background:#1a1a1a;border:1px dashed #333;border-radius:8px;padding:20px;text-align:center;color:#555;font-size:13px}
.sop-placeholder .ph-icon{font-size:28px;margin-bottom:8px}
.sys-card{background:#1a1a1a;border:1px solid #2a2a2a;border-radius:8px;padding:16px;cursor:pointer;transition:border-color 0.15s}
.sys-card:hover{border-color:#555;background:#222}
.sys-card-icon{font-size:24px;margin-bottom:8px}
.sys-card-title{font-size:13px;font-weight:500;color:#fff;margin-bottom:4px}
.sys-card-desc{font-size:11px;color:#666;line-height:1.4}
</style>
</head>
<body>

<!-- UTIL BAR -->
<div class="util-bar">
  <div class="site-title">Legacy Homes Project Management Dashboard</div>
  <div class="util-right" id="util-right">
    <!-- injected by JS based on login state -->
  </div>
</div>

<!-- BRAND BAR -->
<div class="brand-bar">
  <img id="site-logo" alt="Legacy Homes Investments" />
  <div class="brand-divider"></div>
  <div>
    <div class="brand-main">Legacy Homes</div>
    <div class="brand-sub">Project Management Hub &nbsp;&middot;&nbsp; Columbus, OH</div>
  </div>
  <div class="brand-search">
    <input type="text" id="site-search" placeholder="Search..." onkeydown="if(event.key==='Enter')doSearch()" />
    <button class="brand-search-btn" onclick="doSearch()">🔍</button>
  </div>
</div>

<!-- NAV -->
<div class="nav" id="nav" style="display:none">
  <div class="ni has-dd" id="pd-t">⬡ Proj. Director ▾
    <div class="dd" id="pd-d">
      <div class="ddl">Project Director</div>
      <div class="ddi" onclick="openProjectDashboard()">📊 Project Dashboard</div>
      <div class="ddi" onclick="openDesignDashboard()">🎨 Design Dashboard</div>
      <div class="ddi" onclick="openTVDashboard()">📺 TV Dashboard</div>
    </div>
  </div>
  <div class="ni has-dd" id="pm-t">🏗 Proj. Manager ▾
    <div class="dd" id="pm-d">
      <div class="ddl">Project Manager</div>
      <div class="ddi" onclick="openProjectDashboard()">📊 Project Dashboard</div>
      <div class="ddi" onclick="openDesignDashboard()">🎨 Design Dashboard</div>
      <div class="ddi" onclick="openTVDashboard()">📺 TV Dashboard</div>
    </div>
  </div>
  <div class="ni has-dd" id="am-t">👤 Asst. Manager ▾
    <div class="dd" id="am-d">
      <div class="ddl">Assistant Manager</div>
      <div class="ddi" onclick="openPMAssistantDashboard()">🗂 PM Assistant Dashboard</div>
      <div class="ddi" onclick="openProjectDashboard()">📊 Project Dashboard</div>
      <div class="ddi" onclick="openDesignDashboard()">🎨 Design Dashboard</div>
      <div class="ddi" onclick="openTVDashboard()">📺 TV Dashboard</div>
    </div>
  </div>
  <div class="ni has-dd" id="adm-t">🏢 Admin. Mgr ▾
    <div class="dd" id="adm-d">
      <div class="ddl">Administrative Manager</div>
      <div class="ddi" onclick="openAdminDashboard()">🏛 Admin Dashboard</div>
      <div class="ddi" onclick="openProjectDashboard()">📊 Project Dashboard</div>
      <div class="ddi" onclick="openDesignDashboard()">🎨 Design Dashboard</div>
      <div class="ddi" onclick="openTVDashboard()">📺 TV Dashboard</div>
    </div>
  </div>
  <div class="ni has-dd" id="va-t">💻 VA Assistants ▾
    <div class="dd" id="va-d">
      <div class="ddl">VA Assistants</div>
      <div class="ddi" onclick="openSeniorVADashboard()">💼 Senior VA Dashboard</div>
      <div class="ddi" onclick="openVAAdminDashboard()">🖥 VA Admin Dashboard</div>
      <div class="ddi" onclick="openProjectDashboard()">📊 Project Dashboard</div>
      <div class="ddi" onclick="openDesignDashboard()">🎨 Design Dashboard</div>
      <div class="ddi" onclick="openTVDashboard()">📺 TV Dashboard</div>
    </div>
  </div>
  <div class="ni has-dd" id="arch-t">📐 Architect ▾
    <div class="dd" id="arch-d">
      <div class="ddl">Architect</div>
      <div class="ddi" onclick="openArchitectDashboard()">📐 Architect Dashboard</div>
      <div class="ddi" onclick="openProjectDashboard()">📊 Project Dashboard</div>
      <div class="ddi" onclick="openDesignDashboard()">🎨 Design Dashboard</div>
      <div class="ddi" onclick="openTVDashboard()">📺 TV Dashboard</div>
    </div>
  </div>
  <div class="ni has-dd" id="data-t">💾 Data Dash ▾
    <div class="dd" id="data-d" style="min-width:240px">
      <div class="ddl">Financials</div>
      <div class="ddi" id="dd-overhead" onclick="openDataSection('overhead')">💼 PT Overhead &amp; Expenses</div>
      <div class="ddi" id="dd-teamspent" onclick="openDataSection('teamspent')">💸 Project Team Spent</div>
      <div class="ddl" style="margin-top:4px">Project Managers</div>
      <div class="ddi" onclick="openPMDashboard()">👥 PM Team Overview</div>
    </div>
  </div>
  <div class="ni has-dd" id="rep-t">📊 Reporting ▾
    <div class="dd" id="rep-d" style="min-width:220px">
      <div class="ddl">Reports</div>
      <div class="ddi">🗓 Biweekly Reports</div>
      <div class="ddi" onclick="openMonthlyReports()">📅 Monthly Reports</div>
      <div class="ddi">📆 Yearly Reports</div>
      <div class="ddi">🏁 End of Project Reports</div>
    </div>
  </div>
  <div class="ni has-dd" id="sop-t">📖 SOPs ▾
    <div class="dd" id="sop-d" style="min-width:280px">
      <div class="ddl">Job Role SOPs</div>
      <div class="ddi" onclick="openSOP('role','Project Director')">⬡ Project Director SOP</div>
      <div class="ddi" onclick="openSOP('role','Project Manager')">🏗 Project Manager SOP</div>
      <div class="ddi" onclick="openSOP('role','Administrative Assistant')">🏢 Administrative Assistant SOP</div>
      <div class="ddi" onclick="openSOP('role','Senior Administrative Assistant')">🏢 Senior Administrative Assistant SOP</div>
      <div class="ddi" onclick="openSOP('role','Virtual Administrative Assistant')">💻 Virtual Administrative Assistant SOP</div>
      <div class="ddi" onclick="openSOP('role','Senior Virtual Administrative Assistant')">💻 Senior Virtual Administrative Assistant SOP</div>
      <div class="ddi" onclick="openSOP('role','Start of Project Assistant')">🚀 Start of Project Assistant SOP</div>
      <div class="ddi" onclick="openSOP('role','End of Project Assistant')">🏁 End of Project Assistant SOP</div>
      <div class="ddi" onclick="openSOP('role','Assistant / Intern')">🎓 Assistant / Intern SOP</div>
      <div class="ddi" onclick="openSOP('role','VA Assistant')">💻 VA Assistant SOP</div>
      <div class="ddi" onclick="openSOP('role','Architect')">📐 Architect SOP</div>
      <div class="ddl" style="margin-top:4px">Systems &amp; Processes</div>
      <div class="ddi" onclick="openSOP('systems','')">⚙️ Systems &amp; Processes SOPs →</div>
    </div>
  </div>
  <div class="ni has-dd" id="tools-t">🔧 Tools ▾
    <div class="dd" id="tools-d" style="min-width:220px">
      <div class="ddl">External Tools</div>
      <div class="ddi" onclick="window.open('https://signin.eagleview.com/','_blank')">🦅 Eagleview ↗</div>
      <div class="ddi" onclick="window.open('https://www.lowes.com','_blank')">🔨 Lowes ↗</div>
    </div>
  </div>
</div>

<!-- MAIN BODY -->
<div class="dash-body" id="dash-body">
  <div class="empty-state">
    <div class="icon">🏠</div>
    <p>Sign in to access the Legacy Homes dashboard</p>
  </div>
</div>

<!-- ===== SOP ROLE MODAL ===== -->
<div class="overlay" id="sop-modal">
  <div class="modal" style="max-width:700px;padding:0;overflow:hidden">
    <div style="background:#111;padding:20px 28px;border-bottom:1px solid #2a2a2a;display:flex;align-items:center;justify-content:space-between">
      <div>
        <div id="sop-modal-title" style="font-size:17px;font-weight:500;color:#fff"></div>
        <div style="font-size:12px;color:#666;margin-top:3px">Standard Operating Procedure</div>
      </div>
      <button class="modal-close" style="position:static" onclick="closeModal('sop-modal')">✕</button>
    </div>
    <div style="padding:28px;max-height:70vh;overflow-y:auto" id="sop-modal-body"></div>
  </div>
</div>

<!-- ===== SYSTEMS & PROCESSES MODAL ===== -->
<div class="overlay" id="systems-modal">
  <div class="modal" style="max-width:720px;padding:0;overflow:hidden">
    <div style="background:#111;padding:20px 28px;border-bottom:1px solid #2a2a2a;display:flex;align-items:center;justify-content:space-between">
      <div>
        <div style="font-size:17px;font-weight:500;color:#fff">⚙️ Systems &amp; Processes SOPs</div>
        <div style="font-size:12px;color:#666;margin-top:3px">Click any system to view its SOP</div>
      </div>
      <button class="modal-close" style="position:static" onclick="closeModal('systems-modal')">✕</button>
    </div>
    <div style="padding:28px">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px" id="systems-grid"></div>
    </div>
  </div>
</div>

<!-- ===== SYSTEMS SOP DETAIL MODAL ===== -->
<div class="overlay" id="sys-sop-modal">
  <div class="modal" style="max-width:700px;padding:0;overflow:hidden">
    <div style="background:#111;padding:20px 28px;border-bottom:1px solid #2a2a2a;display:flex;align-items:center;justify-content:space-between">
      <div>
        <div id="sys-sop-title" style="font-size:17px;font-weight:500;color:#fff"></div>
        <div style="font-size:12px;color:#666;margin-top:3px">Systems &amp; Processes SOP &nbsp;·&nbsp; <span style="color:#888;cursor:pointer;text-decoration:underline" onclick="closeModal('sys-sop-modal');openModal('systems-modal')">← Back to Systems</span></div>
      </div>
      <button class="modal-close" style="position:static" onclick="closeModal('sys-sop-modal')">✕</button>
    </div>
    <div style="padding:28px;max-height:70vh;overflow-y:auto" id="sys-sop-body"></div>
  </div>
</div>

<!-- ===== ACCESS DENIED MODAL ===== -->
<div class="overlay" id="access-denied-modal">
  <div class="modal" style="max-width:400px;text-align:center">
    <button class="modal-close" onclick="closeModal('access-denied-modal')">✕</button>
    <div style="font-size:36px;margin-bottom:12px">🔒</div>
    <h2 style="margin-bottom:8px">Access Restricted</h2>
    <p class="sub" id="access-denied-msg" style="margin-bottom:24px"></p>
    <button class="btn-full outline" onclick="closeModal('access-denied-modal')">Go Back</button>
  </div>
</div>

<!-- ===== PM DASHBOARD MODAL ===== -->
<div class="overlay" id="pm-dash-modal">
  <div class="modal" style="max-width:1080px;width:95%;padding:0;overflow:hidden">
    <div style="background:#111;padding:20px 28px;border-bottom:1px solid #2a2a2a;display:flex;align-items:center;justify-content:space-between">
      <div>
        <div id="pm-dash-title" style="font-size:17px;font-weight:500;color:#fff">👥 Project Manager Team Overview</div>
